# Build output
build/
out/
cmake-build-*/
.gradle/
worker/build/
worker/.gradle/

# IDE
.idea/
.vs/
.vscode/
*.user
CMakeUserPresets.json
__pycache__/
*.pyc

# Release archives are uploaded to GitHub, never committed
dist/

# Local caches / staging
/local/
/worker/local/
/third_party/chunker/
*.chunkdaddy-workspace/

# Generated logs, scratch files and JVM heap dumps
*.log
*.tmp
*.hprof

# Test worlds and large fixtures are not distributed
tests/fixtures/worlds/
tests/fixtures/schematics/*.schem
!tests/fixtures/schematics/tiny-*.schem
